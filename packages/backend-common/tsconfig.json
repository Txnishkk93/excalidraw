{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "verbatimModuleSyntax": true,
    "noEmit": false
  },
  "include": ["src/**/*.ts"]
}
